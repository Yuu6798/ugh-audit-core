# OPERATOR ONLY. This example contains no credentials and is not auto-loaded.
# Supply actual values through your deployment's environment/secret manager.
UGH_ACCESS_MODE=invite
UGH_INVITE_FILE=/data/ugh/invites.json
UGH_AUDIT_DB=/data/ugh/audit.db
UGH_USAGE_DB=/data/ugh/usage.db
UGH_AUDIT_CACHE_DIR=/data/ugh/cache
UGH_META_CACHE_DIR=/data/ugh/meta-cache
# Set the actual public Host value; include port if nondefault. CSV supported.
UGH_ALLOWED_HOSTS=audit.example.com
# Exact origins of trusted clients, CSV; empty means clients sending no Origin.
UGH_ALLOWED_ORIGINS=
UGH_REQUESTS_PER_MINUTE=60
UGH_AUDITS_PER_DAY=100
UGH_GLOBAL_AUDITS_PER_DAY=500
UGH_CONCURRENT_PER_USER=1
UGH_CONCURRENT_GLOBAL=4
# Required for actual semantic assessment, including explicit requirements.
# Also required for optional auto_generate_meta; keep it on the server only.
ANTHROPIC_API_KEY=
