# Client-side placeholders only. Load through your agent host's secret settings.
# These are not audit-server environment variables or Agensi credentials.
UGH_MCP_ENDPOINT=https://audit.example.com/mcp/
UGH_AUDIT_TOKEN=
# User-owned Anthropic key, mapped to X-UGH-Anthropic-Key by a compatible client.
# Fill only in private host secret settings; never copy the value into this package.
UGH_ANTHROPIC_API_KEY=
